<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Wishlist</title>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Inter',sans-serif;
}

body{
background:#fff;
}

.wishlist{
padding:70px 8%;
}

.wishlist h1{
font-size:48px;
margin-bottom:45px;
}

.wishlist-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:30px;
}

.card{
background:#fff;
border-radius:18px;
overflow:hidden;
box-shadow:0 8px 20px rgba(0,0,0,0.08);
transition:0.4s;
}

.card:hover{
transform:translateY(-8px);
}

.card img{
width:100%;
height:350px;
object-fit:cover;
}

.content{
padding:22px;
}

.content h3{
margin-bottom:12px;
}

.content p{
color:#666;
line-height:1.7;
margin-bottom:15px;
}

.price{
font-size:24px;
font-weight:700;
margin-bottom:20px;
}

.actions{
display:flex;
gap:12px;
}

.actions button{
flex:1;
padding:14px;
border:none;
border-radius:10px;
font-weight:700;
cursor:pointer;
}

.cart-btn{
background:#111;
color:#fff;
}

.remove-btn{
background:#f3f3f3;
}

</style>

</head>

<body>

<section class="wishlist">

<h1>My Wishlist</h1>

<div class="wishlist-grid">

<div class="card">

<img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1200">

<div class="content">

<h3>Premium Beige Coat</h3>

<p>Elegant winter collection coat with luxury premium fabric.</p>

<div class="price">₹4,999</div>

<div class="actions">

<button class="cart-btn">
Add To Cart
</button>

<button class="remove-btn">
Remove
</button>

</div>

</div>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=1200">

<div class="content">

<h3>Oversized White Shirt</h3>

<p>Relaxed fit premium shirt for timeless fashion looks.</p>

<div class="price">₹1,899</div>

<div class="actions">

<button class="cart-btn">
Add To Cart
</button>

<button class="remove-btn">
Remove
</button>

</div>

</div>

</div>

</div>

</section>

</body>
</html>
