<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>H&M Move Sports</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Inter',sans-serif;
}

body{
  background:#fff;
  color:#111;
}

.hero{
  width:100%;
  height:90vh;
  position:relative;
}

.hero img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.45);
}

.hero-content{
  position:absolute;
  top:50%;
  left:8%;
  transform:translateY(-50%);
  color:#fff;
}

.hero-content h1{
  font-size:72px;
  margin-bottom:20px;
}

.hero-content p{
  font-size:18px;
  line-height:1.7;
  margin-bottom:30px;
  max-width:600px;
}

.hero-content button{
  padding:15px 35px;
  border:none;
  background:#fff;
  font-weight:700;
  cursor:pointer;
}

.section{
  padding:80px 8%;
}

.section-title{
  text-align:center;
  margin-bottom:50px;
}

.section-title h2{
  font-size:42px;
  margin-bottom:15px;
}

.product-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:30px;
}

.product-card{
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 8px 20px rgba(0,0,0,0.08);
  transition:0.4s;
}

.product-card:hover{
  transform:translateY(-8px);
}

.product-card img{
  width:100%;
  height:420px;
  object-fit:cover;
}

.product-info{
  padding:24px;
}

.product-info h3{
  margin-bottom:10px;
}

.product-info p{
  color:#666;
  line-height:1.7;
  margin-bottom:15px;
}

.price{
  margin-bottom:20px;
}

.new-price{
  font-size:24px;
  font-weight:800;
}

.old-price{
  text-decoration:line-through;
  color:#888;
  margin-left:10px;
}

.buttons{
  display:flex;
  gap:12px;
}

.buttons button{
  flex:1;
  padding:14px;
  border:none;
  cursor:pointer;
  border-radius:8px;
  font-weight:700;
}

.cart-btn{
  background:#111;
  color:#fff;
}

.buy-btn{
  background:#f3f3f3;
}

footer{
  background:#111;
  color:#fff;
  text-align:center;
  padding:35px;
}

</style>

</head>

<body>

<section class="hero">

  <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=1600">

  <div class="overlay"></div>

  <div class="hero-content">

    <h1>H&M MOVE</h1>

    <p>
      Discover premium activewear, gym essentials and modern sports fashion designed for movement.
    </p>

    <button>SHOP NOW</button>

  </div>

</section>

<section class="section">

  <div class="section-title">

    <h2>Trending Sportswear</h2>

    <p>Premium fitness collection inspired by H&M Move.</p>

  </div>

  <div class="product-grid">

    <div class="product-card">

      <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?q=80&w=1200">

      <div class="product-info">

        <h3>Training Hoodie</h3>

        <p>
          Premium sports hoodie designed for comfort and flexibility.
        </p>

        <div class="price">

          <span class="new-price">₹2,499</span>

          <span class="old-price">₹3,799</span>

        </div>

        <div class="buttons">

          <button class="cart-btn">Add to Cart</button>

          <button class="buy-btn">Buy Now</button>

        </div>

      </div>

    </div>

    <div class="product-card">

      <img src="https://images.unsplash.com/photo-1514996937319-344454492b37?q=80&w=1200">

      <div class="product-info">

        <h3>Performance Set</h3>

        <p>
          Breathable premium sportswear crafted for active lifestyles.
        </p>

        <div class="price">

          <span class="new-price">₹3,299</span>

          <span class="old-price">₹4,999</span>

        </div>

        <div class="buttons">

          <button class="cart-btn">Add to Cart</button>

          <button class="buy-btn">Buy Now</button>

        </div>

      </div>

    </div>

    <div class="product-card">

      <img src="https://images.unsplash.com/photo-1517963879433-6ad2b056d712?q=80&w=1200">

      <div class="product-info">

        <h3>Running Jacket</h3>

        <p>
          Lightweight running jacket built for premium performance.
        </p>

        <div class="price">

          <span class="new-price">₹2,899</span>

          <span class="old-price">₹4,299</span>

        </div>

        <div class="buttons">

          <button class="cart-btn">Add to Cart</button>

          <button class="buy-btn">Buy Now</button>

        </div>

      </div>

    </div>

  </div>

</section>

<footer>
  © 2026 H&M Move Sports Collection
</footer>

</body>
</html>
