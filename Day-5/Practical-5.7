          </p>

        </div>

        <div class="contact-card">

          <i class="fa-solid fa-clock"></i>

          <h3>Working Hours</h3>

          <p>
            Mon - Sat : 9 AM - 8 PM
          </p>

        </div>

      </div>

    </div>

  </div>

</section>

<!-- FOOTER -->

<footer>

  <h2>H&M Fashion Store</h2>

  <p>
    Discover premium collections for men, women, kids, sportswear and accessories
    inspired by modern global fashion trends.
  </p>

</footer>

<!-- JAVASCRIPT -->

<script>

const faqs = document.querySelectorAll(".faq");

faqs.forEach(faq => {

  faq.addEventListener("click", ()=>{

    faq.classList.toggle("active");

  });

});

</script>

</body>

</html>
