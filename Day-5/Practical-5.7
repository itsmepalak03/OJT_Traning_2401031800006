      <div class="faq-answer">

        Orders are usually delivered within 2-5 business days depending on your location.

      </div>

    </div>

    <div class="faq">

      <div class="faq-question">

        Can I return products?

        <i class="fa-solid fa-plus"></i>

      </div>

      <div class="faq-answer">

        Yes, we provide an easy 7-day return and exchange policy.

      </div>

    </div>

    <div class="faq">

      <div class="faq-question">

        Are payments secure?

        <i class="fa-solid fa-plus"></i>

      </div>

      <div class="faq-answer">

        Absolutely. All payments are protected with secure encrypted systems.

      </div>

    </div>

    <div class="faq">

      <div class="faq-question">

        Do you offer international shipping?

        <i class="fa-solid fa-plus"></i>

      </div>

      <div class="faq-answer">

        Yes, international delivery is available in selected countries.

      </div>

    </div>

  </div>

</section>

<!-- FEEDBACK + CONTACT -->

<section class="section">

  <div class="feedback-wrapper">

    <!-- FEEDBACK -->

    <div class="feedback-box">

      <h3>Send Feedback</h3>

      <p>
        We value your feedback. Share your experience and suggestions with us.
      </p>

      <form class="feedback-form">

        <input type="text" placeholder="Your Name" required>

        <input type="email" placeholder="Your Email" required>

        <textarea placeholder="Write your feedback..." required></textarea>

        <button type="submit">
          Submit Feedback
        </button>

      </form>

    </div>

    <!-- CONTACT -->

    <div class="feedback-box">

      <h3>Contact Us</h3>

      <p>
        Reach out to our support team anytime for assistance.
      </p>

      <div class="contact-grid">

        <div class="contact-card">

          <i class="fa-solid fa-phone"></i>

          <h3>Phone</h3>

          <p>
            +91 98765 43210
          </p>

        </div>

