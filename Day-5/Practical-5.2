    .social-icons i{
      width:40px;
      height:40px;
      background:#111;
      color:#fff;
      display:flex;
      justify-content:center;
      align-items:center;
      border-radius:50%;
      cursor:pointer;
    }

    .copyright{
      text-align:center;
      padding-top:50px;
      color:#777;
      font-size:14px;
    }

    /* ================= RESPONSIVE ================= */

