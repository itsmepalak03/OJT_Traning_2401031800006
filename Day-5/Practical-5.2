<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>H&M Ladies Collection</title>

  <!-- GOOGLE FONT -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <!-- FONT AWESOME -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Inter',sans-serif;
    }

    body{
      background:#fff;
      color:#111;
      overflow-x:hidden;
    }

    html{
      scroll-behavior:smooth;
    }

    a{
      text-decoration:none;
    }

    /* ================= TOP BAR ================= */

    .top-bar{
      width:100%;
      background:#111;
      color:#fff;
      text-align:center;
      padding:12px;
      font-size:13px;
      letter-spacing:1px;
      font-weight:500;
    }

    /* ================= HEADER ================= */

    header{
      width:100%;
      background:#fff;
      position:sticky;
      top:0;
      z-index:999;
      border-bottom:1px solid #eee;
    }

    .navbar{
      width:100%;
      height:85px;
      padding:0 70px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .left-side{
      display:flex;
      align-items:center;
      gap:60px;
    }

    .logo img{
      width:70px;
    }

    .nav-links{
      display:flex;
      list-style:none;
      gap:30px;
    }

    .nav-links a{
      color:#444;
      font-size:14px;
      font-weight:600;
      position:relative;
      transition:0.3s;
    }

    .nav-links a:hover,
    .nav-links a.active{
      color:#000;
    }

    .nav-links a.active::after{
      content:'';
      position:absolute;
      left:0;
      bottom:-10px;
      width:100%;
      height:2px;
      background:#000;
    }

    .right-side{
      display:flex;
      align-items:center;
      gap:22px;
    }

    .search-box{
      display:flex;
      align-items:center;
      gap:10px;
      border-bottom:1px solid #ccc;
      padding-bottom:5px;
    }

    .search-box input{
      border:none;
      outline:none;
      background:transparent;
      width:120px;
    }

    .icon-box{
      position:relative;
      font-size:20px;
      cursor:pointer;
    }

    .count{
      position:absolute;
      top:-10px;
      right:-10px;
      width:18px;
      height:18px;
      border-radius:50%;
      background:red;
      color:#fff;
      display:flex;
      justify-content:center;
      align-items:center;
      font-size:10px;
    }

    /* ================= HERO ================= */

    .hero{
      width:100%;
      height:90vh;
      position:relative;
    }

    .hero img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .overlay{
      position:absolute;
      inset:0;
      background:rgba(0,0,0,0.45);
    }

    .hero-content{
      position:absolute;
      top:50%;
      left:8%;
      transform:translateY(-50%);
      color:#fff;
      max-width:650px;
    }

    .hero-content h1{
      font-size:74px;
      line-height:1;
      margin-bottom:20px;
      font-weight:800;
    }

    .hero-content p{
      line-height:1.8;
      font-size:18px;
      margin-bottom:30px;
    }

    .hero-content button{
      padding:16px 35px;
      border:none;
      background:#fff;
      color:#000;
      font-weight:700;
      cursor:pointer;
      transition:0.4s;
    }

    .hero-content button:hover{
      background:#000;
      color:#fff;
    }

    /* ================= SECTION TITLE ================= */

    .section-title{
      text-align:center;
      margin-bottom:50px;
    }

    .section-title h2{
      font-size:42px;
      margin-bottom:15px;
    }

    .section-title p{
      color:#666;
    }

    /* ================= CATEGORY ================= */

    .categories{
      padding:80px 8%;
    }

    .category-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
      gap:25px;
    }

    .category-card{
      position:relative;
      overflow:hidden;
      border-radius:18px;
      cursor:pointer;
    }

    .category-card img{
      width:100%;
      height:360px;
      object-fit:cover;
      transition:0.5s;
    }

    .category-card:hover img{
      transform:scale(1.08);
    }

    .category-name{
      position:absolute;
      bottom:25px;
      left:25px;
      color:#fff;
      font-size:28px;
      font-weight:700;
    }

    /* ================= FILTER ================= */

    .filter-bar{
      padding:0 8% 30px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:20px;
    }

    .filter-left{
      display:flex;
      gap:15px;
      flex-wrap:wrap;
    }

    .filter-btn{
      padding:10px 20px;
      border:1px solid #ddd;
      background:#fff;
      cursor:pointer;
      transition:0.3s;
      font-weight:600;
    }

    .filter-btn:hover{
      background:#111;
      color:#fff;
      border-color:#111;
    }

    .sort-box select{
      padding:12px 16px;
      border:1px solid #ddd;
      outline:none;
      cursor:pointer;
    }

    /* ================= PRODUCTS ================= */

    .products{
      padding:20px 8% 90px;
    }

    .product-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:35px;
    }

    .product-card{
      background:#fff;
      border-radius:18px;
      overflow:hidden;
      transition:0.4s;
      box-shadow:0 8px 25px rgba(0,0,0,0.08);
      position:relative;
    }

    .product-card:hover{
      transform:translateY(-8px);
    }

    .product-image{
      position:relative;
      overflow:hidden;
    }

    .product-image img{
      width:100%;
      height:420px;
      object-fit:cover;
      transition:0.5s;
    }

    .product-card:hover img{
      transform:scale(1.07);
    }

    .wishlist-btn{
      position:absolute;
      top:15px;
      right:15px;
      width:42px;
      height:42px;
      background:#fff;
      border-radius:50%;
      display:flex;
      justify-content:center;
      align-items:center;
      cursor:pointer;
      font-size:18px;
      transition:0.3s;
      box-shadow:0 5px 12px rgba(0,0,0,0.15);
    }

    .wishlist-btn.active{
      color:red;
    }

    .sale-tag{
      position:absolute;
      top:15px;
      left:15px;
      background:#e4002b;
      color:#fff;
      padding:8px 12px;
      font-size:12px;
      font-weight:700;
      border-radius:5px;
    }

    .product-info{
      padding:24px;
    }

    .brand{
      color:#888;
      font-size:13px;
      margin-bottom:8px;
      letter-spacing:1px;
    }

    .product-info h3{
      font-size:20px;
      margin-bottom:10px;
    }

    .description{
      color:#666;
      line-height:1.7;
      margin-bottom:15px;
      font-size:14px;
    }

    .details{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-bottom:18px;
    }

    .details span{
      background:#f3f3f3;
      padding:7px 12px;
      border-radius:20px;
      font-size:12px;
      font-weight:600;
    }

    .rating{
      color:#ffb400;
      margin-bottom:15px;
      font-size:14px;
    }

    .price{
      margin-bottom:20px;
    }

    .new-price{
      font-size:24px;
      font-weight:800;
    }

    .old-price{
      text-decoration:line-through;
      color:#888;
      margin-left:10px;
    }

    .discount{
      color:green;
      margin-left:10px;
      font-weight:700;
    }

    .product-buttons{
      display:flex;
      gap:12px;
    }

    .cart-btn,
    .buy-btn{
      flex:1;
      padding:14px;
      border:none;
      border-radius:10px;
      cursor:pointer;
      font-weight:700;
      transition:0.3s;
    }

    .cart-btn{
      background:#111;
      color:#fff;
    }

    .buy-btn{
      background:#f2f2f2;
    }

    .cart-btn:hover{
      background:#000;
    }

    .buy-btn:hover{
      background:#ddd;
    }

    /* ================= NEWSLETTER ================= */

    .newsletter{
      background:#111;
      color:#fff;
      padding:80px 8%;
      text-align:center;
    }

    .newsletter h2{
      font-size:42px;
      margin-bottom:20px;
    }

    .newsletter p{
      color:#ccc;
      margin-bottom:30px;
      line-height:1.8;
    }

    .newsletter-box{
      max-width:600px;
      margin:auto;
      display:flex;
      background:#fff;
      border-radius:10px;
      overflow:hidden;
    }

    .newsletter-box input{
      flex:1;
      padding:18px;
      border:none;
      outline:none;
    }

    .newsletter-box button{
