<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>H&M Clone</title>

  <!-- GOOGLE FONT -->
  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">

  <!-- FONT AWESOME -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Inter',sans-serif;
    }

    body{
      background:#fff;
      overflow-x:hidden;
    }

    html{
      scroll-behavior:smooth;
    }

    /* ================= TOP BAR ================= */

    .top-bar{
      width:100%;
      background:#111;
      color:#fff;
      text-align:center;
      padding:12px;
      font-size:13px;
      letter-spacing:1px;
      font-weight:500;
    }

    /* ================= HEADER ================= */

    header{
      width:100%;
      background:#fff;
      position:sticky;
      top:0;
      z-index:999;
      border-bottom:1px solid #eee;
    }

    .navbar{
      width:100%;
      height:85px;
      padding:0 60px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .left-side{
      display:flex;
      align-items:center;
      gap:60px;
    }

    .logo img{
      width:70px;
      cursor:pointer;
      transition:0.4s;
    }

    .logo img:hover{
      transform:scale(1.1) rotate(2deg);
    }

    .nav-links{
      display:flex;
      list-style:none;
      gap:30px;
    }

    .nav-links a{
      text-decoration:none;
      color:#444;
      font-size:14px;
      font-weight:600;
      letter-spacing:0.5px;
      transition:0.3s;
      position:relative;
    }

    .nav-links a:hover{
      color:#000;
      transform:translateY(-2px);
    }

    .nav-links a.active{
      color:#000;
    }

    .nav-links a.active::after{
      content:'';
      position:absolute;
      left:0;
      bottom:-10px;
      width:100%;
      height:2px;
      background:#000;
    }

    .right-side{
      display:flex;
      align-items:center;
      gap:22px;
    }

    .search-box{
      display:flex;
      align-items:center;
      gap:10px;
      border-bottom:1px solid #ccc;
      padding-bottom:5px;
    }

    .search-box input{
      border:none;
      outline:none;
      width:120px;
      background:transparent;
      font-size:14px;
    }

    .icon-box{
      font-size:20px;
      cursor:pointer;
      transition:0.3s;
      color:#000;
      text-decoration:none;
    }

    .icon-box:hover{
      transform:translateY(-4px) scale(1.1);
    }

    .menu-btn{
      display:none;
      font-size:24px;
      cursor:pointer;
    }

    /* ================= HERO SLIDER ================= */

    .hero-slider{
      width:100%;
      height:92vh;
      position:relative;
      overflow:hidden;
    }

    .slide{
      position:absolute;
      width:100%;
      height:100%;
      opacity:0;
      transform:scale(1.1);
      transition:1.2s ease;
    }

    .slide.active{
      opacity:1;
      transform:scale(1);
      z-index:2;
    }

    .slide img{
      width:100%;
      height:100%;
      object-fit:cover;
      animation:zoom 8s linear infinite;
    }

    @keyframes zoom{
      0%{
        transform:scale(1);
      }
      100%{
        transform:scale(1.08);
      }
    }

    .overlay{
      position:absolute;
      inset:0;
      background:linear-gradient(to right,
      rgba(0,0,0,0.6),
      rgba(0,0,0,0.15));
    }

    .slide-content{
      position:absolute;
      top:50%;
      left:8%;
      transform:translateY(-50%);
      color:#fff;
      z-index:5;
      max-width:620px;
      animation:slideText 1.2s ease;
    }

    @keyframes slideText{
      from{
        opacity:0;
        transform:translate(-60px,-50%);
      }
      to{
        opacity:1;
        transform:translate(0,-50%);
      }
    }

    .slide-content h1{
      font-size:78px;
      line-height:1;
      margin-bottom:25px;
      font-weight:800;
      letter-spacing:-2px;
      text-shadow:0 5px 20px rgba(0,0,0,0.5);
    }

    .slide-content p{
      font-size:18px;
      line-height:1.7;
      margin-bottom:35px;
    }

    .slide-content button{
      padding:16px 38px;
      border:none;
      background:#fff;
      color:#000;
      font-size:13px;
      font-weight:700;
      cursor:pointer;
      transition:0.4s;
      letter-spacing:1px;
    }

    .slide-content button:hover{
      background:#000;
      color:#fff;
      transform:translateY(-5px) scale(1.05);
    }

    /* BUTTONS */

    .prev-btn,
    .next-btn{
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      width:55px;
      height:55px;
      border:none;
      border-radius:50%;
      background:rgba(255,255,255,0.8);
      font-size:18px;
      cursor:pointer;
      z-index:20;
      transition:0.4s;
    }

    .prev-btn:hover,
    .next-btn:hover{
      transform:translateY(-50%) scale(1.15);
      background:#fff;
    }

    .prev-btn{
      left:25px;
    }

    .next-btn{
      right:25px;
    }

    /* DOTS */

    .dots{
      position:absolute;
      bottom:30px;
      width:100%;
      display:flex;
      justify-content:center;
      gap:12px;
      z-index:50;
    }

    .dot{
      width:12px;
      height:12px;
      border-radius:50%;
      background:rgba(255,255,255,0.5);
      cursor:pointer;
      transition:0.4s;
    }

    .dot.active{
      background:#fff;
      transform:scale(1.4);
    }

    /* ================= COLLECTION SECTION ================= */

    .collection{
      width:100%;
      padding:90px 8%;
    }

    .collection-title{
      text-align:center;
      margin-bottom:60px;
    }

    .collection-title h2{
      font-size:48px;
      margin-bottom:15px;
    }

    .collection-title p{
      color:#666;
      font-size:16px;
    }

    .collection-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:30px;
    }

    .collection-card{
      overflow:hidden;
      border-radius:18px;
      background:#fff;
      box-shadow:0 8px 20px rgba(0,0,0,0.08);
      transition:0.5s;
    }

    .collection-card:hover{
      transform:translateY(-12px) scale(1.03);
    }

    .collection-card img{
      width:100%;
      height:400px;
      object-fit:cover;
      transition:0.5s;
    }

    .collection-card:hover img{
      transform:scale(1.08);
    }

    .collection-content{
      padding:25px;
    }

    .collection-content h3{
      margin-bottom:12px;
      font-size:22px;
    }

    .collection-content p{
      color:#666;
      line-height:1.7;
      margin-bottom:20px;
    }

    .collection-content a{
      text-decoration:none;
      color:#000;
      font-weight:700;
      letter-spacing:1px;
    }

    /* ================= H&M FOOTER ================= */

    /* ================= H&M FOOTER ================= */

.hm-footer{
  width:100%;
  background:#f4f4f4;
  padding:45px 5% 20px;
  margin-top:60px;
}

.footer-top-text{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:40px;
}

.footer-top-text h3{
  font-size:18px;
  font-weight:600;
  letter-spacing:1px;
}

.footer-top-text i{
  font-size:20px;
  cursor:pointer;
}

.footer-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:35px;
  margin-bottom:50px;
}

.footer-column h4{
  font-size:18px;
  margin-bottom:18px;
  font-weight:700;
}

.footer-column ul{
  list-style:none;
}

.footer-column ul li{
  margin-bottom:12px;
}

.footer-column ul li a{
  text-decoration:none;
  color:#111;
  font-size:14px;
  transition:0.3s;
}

.footer-column ul li a:hover{
  opacity:0.6;
}

.member-box p{
  font-size:14px;
  line-height:1.6;
  margin-bottom:18px;
  color:#222;
}

.member-box a{
  color:#111;
  font-size:15px;
  font-weight:600;
  text-decoration:underline;
}

.footer-middle{
  margin-bottom:40px;
}

.footer-logo img{
  width:60px;
  margin-bottom:20px;
}

.region{
  display:flex;
  align-items:center;
  gap:18px;
}

.region span{
  font-size:15px;
  font-weight:700;
}

.region a{
  color:#111;
  font-size:14px;
}

.footer-bottom{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:30px;
}

.footer-bottom p{
  max-width:750px;
  line-height:1.7;
  font-size:13px;
  color:#222;
}

.social-icons{
  display:flex;
  gap:18px;
}

.social-icons a{
  color:#111;
  font-size:22px;
  transition:0.3s;
}

.social-icons a:hover{
  transform:translateY(-3px);
}

/* FOOTER RESPONSIVE */

@media(max-width:992px){

  .footer-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .footer-bottom{
    flex-direction:column;
    align-items:flex-start;
  }
}

@media(max-width:768px){

  .footer-top-text{
    flex-direction:column;
    align-items:flex-start;
    gap:15px;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }

  .footer-middle{
    margin-bottom:30px;
  }

  .social-icons{
    margin-top:15px;
  }
}

@media(max-width:480px){

  .hm-footer{
    padding:35px 5% 20px;
  }

  .footer-top-text h3{
    font-size:16px;
  }

  .social-icons a{
    font-size:20px;
  }
}
    /* ================= RESPONSIVE ================= */

    @media(max-width:992px){

      .navbar{
        padding:0 25px;
      }

      .slide-content h1{
        font-size:56px;
      }

      .footer-grid{
        grid-template-columns:repeat(2,1fr);
      }

      .footer-bottom{
        flex-direction:column;
        align-items:flex-start;
      }
    }

    @media(max-width:768px){

      .navbar{
        height:75px;
      }

      .menu-btn{
        display:block;
      }

      .nav-links{
        position:absolute;
        top:75px;
        left:-100%;
        width:100%;
        background:#fff;
        flex-direction:column;
        padding:30px;
        gap:25px;
        transition:0.4s;
      }

      .nav-links.active{
        left:0;
      }

      .search-box{
        display:none;
      }

      .hero-slider{
        height:75vh;
      }

      .slide-content{
        left:7%;
      }

      .slide-content h1{
        font-size:42px;
      }

      .slide-content p{
        font-size:15px;
      }

      .footer-top-text{
        flex-direction:column;
        align-items:flex-start;
        gap:20px;
      }

      .footer-grid{
        grid-template-columns:1fr;
      }

      .footer-column h4{
        font-size:20px;
      }

      .footer-column ul li a,
      .member-box p,
      .footer-bottom p{
        font-size:16px;
      }

      .region{
        flex-direction:column;
        align-items:flex-start;
        gap:10px;
      }

      .social-icons{
        margin-top:20px;
      }
    }

    @media(max-width:480px){

      .hero-slider{
        height:65vh;
      }

      .slide-content h1{
        font-size:30px;
      }

      .slide-content p{
        font-size:13px;
      }

      .slide-content button{
        padding:12px 22px;
        font-size:11px;
      }

      .logo img{
        width:55px;
      }

      .hm-footer{
        padding:50px 5% 25px;
      }

      .footer-top-text h3{
        font-size:20px;
      }

      .social-icons a{
        font-size:26px;
      }
    }

  </style>

</head>

