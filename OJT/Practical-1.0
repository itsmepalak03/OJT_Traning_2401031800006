<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>H&M Header Clone</title>

  <link rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, sans-serif;
    }

    body{
      background:#f5f5f5;
    }

    .top-header{
      width:100%;
      background:white;
      border-bottom:1px solid #e5e5e5;
      padding:10px 50px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      font-size:13px;
    }

    .top-left,
    .top-right{
      display:flex;
      gap:22px;
      align-items:center;
    }

    .top-header a{
      text-decoration:none;
      color:#444;
    }

    .top-header a:hover{
      color:red;
    }
    
    .main-header{
      width:100%;
      background:white;
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:22px 50px;
      position:relative;
    }


    .nav-links{
      display:flex;
      gap:28px;
      align-items:center;
    }

    .nav-links a{
      text-decoration:none;
      color:black;
      font-size:15px;
      font-weight:500;
      transition:0.3s;
    }

    .nav-links a:hover{
      color:#d6001c;
    }

    .logo{
      position:absolute;
      left:50%;
      transform:translateX(-50%);
    }

    .logo img{
      width:80px;
      height:auto;
      display:block;
    }

    .right-section{
      display:flex;
      align-items:center;
      gap:25px;
    }


    .search-box{
      display:flex;
      align-items:center;
      border-bottom:1px solid black;
      padding-bottom:5px;
      gap:8px;
    }

    .search-box input{
      border:none;
      outline:none;
      background:none;
      font-size:14px;
      width:170px;
    }


    .icons{
      display:flex;
      gap:18px;
      font-size:18px;
      cursor:pointer;
      color:black;
    }

    .icons i:hover{
      color:#d6001c;
    }

    .menu-btn{
      display:none;
      font-size:22px;
      cursor:pointer;
    }

    @media(max-width:950px){

      .top-header{
        display:none;
      }

      .main-header{
        padding:18px 20px;
      }

      .nav-links{
        display:none;
      }

      .search-box{
        display:none;
      }

      .menu-btn{
        display:block;
      }

      .logo{
        position:static;
        transform:none;
      }

      .logo img{
        width:65px;
      }

      .right-section{
        gap:18px;
      }

    }

  </style>
</head>

<body>


  <div class="top-header">

    <div class="top-left">
      <a href="#">Customer Service</a>
      <a href="#">Newsletter</a>
      <a href="#">Find a Store</a>
    </div>

    <div class="top-right">
      <a href="#"><i class="fa-regular fa-user"></i> Sign In</a>
      <a href="#">INDIA | ₹</a>
    </div>

  </div>

  <header class="main-header">


    <div class="menu-btn">
      <i class="fa-solid fa-bars"></i>
    </div>


    <nav class="nav-links">
      <a href="#">Ladies</a>
      <a href="#">Men</a>
      <a href="#">Baby</a>
      <a href="#">Kids</a>
      <a href="#">Home</a>
      <a href="#">Sport</a>
      <a href="#">Sale</a>
    </nav>


    <div class="logo">

      <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/H%26M-Logo.svg" alt="H&M Logo">

    </div>


    <div class="right-section">

      <div class="search-box">
        <input type="text" placeholder="Search products">
        <i class="fa-solid fa-magnifying-glass"></i>
      </div>


      <div class="icons">
        <i class="fa-regular fa-heart"></i>
        <i class="fa-solid fa-bag-shopping"></i>
      </div>

    </div>

  </header>

</body>
</html>
