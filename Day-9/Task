        /* Topbar */
        .topbar { background: var(--dark); font-size: 12px; letter-spacing: 1.5px; }

        /* Navbar */
        .navbar { border-bottom: 1px solid #f0f0f0; }
        .nav-link { font-weight: 600; font-size: 13px; letter-spacing: 0.8px; color: var(--dark) !important; position: relative; padding-bottom: 4px !important; }
