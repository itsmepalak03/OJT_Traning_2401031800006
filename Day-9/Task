        .nav-link:hover { color: var(--red) !important; }
        .navbar-brand img { height: 38px; width: auto; }

        /* Search */
        .search-wrap { background: #f5f5f5; border-radius: 50px; overflow: hidden; }
        .search-wrap input { border: none; background: transparent; outline: none; box-shadow: none !important; font-size: 13px; }

        /* Icon buttons */
        .icon-btn { width: 42px; height: 42px; border-radius: 50%; border: 1px solid #e0e0e0; background: #fff; display: flex; align-items: center; justify-content: center; transition: .25s; cursor: pointer; position: relative; }
        .icon-btn:hover { background: var(--dark); color: #fff; border-color: var(--dark); }

        /* Hero */
        .hero-img { height: 90vh; object-fit: cover; }
        .hero-overlay { background: linear-gradient(to right, rgba(0,0,0,.72) 0%, rgba(0,0,0,.15) 60%, transparent 100%); }
        .hero-tag { font-size: 11px; letter-spacing: 3px; }
        .hero-title { font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 1.05; }

        /* Category cards */
        .cat-card { border-radius: 20px; overflow: hidden; height: 480px; }
        .cat-card img { height: 100%; object-fit: cover; transition: transform .55s cubic-bezier(.25,.46,.45,.94); }
        .cat-card:hover img { transform: scale(1.08); }
        .cat-overlay { background: linear-gradient(to top, rgba(0,0,0,.65) 0%, transparent 55%); }

        /* Product cards */
        .prod-card { border-radius: 20px; overflow: hidden; border: none; transition: transform .3s, box-shadow .3s; }
        .prod-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,.1) !important; }
        .prod-img-wrap { height: 360px; overflow: hidden; }
        .prod-img-wrap img { height: 100%; object-fit: cover; transition: transform .55s; }
        .prod-card:hover .prod-img-wrap img { transform: scale(1.06); }
        .wl-btn { position: absolute; top: 12px; right: 12px; width: 38px; height: 38px; border-radius: 50%; background: #fff; border: none; box-shadow: 0 3px 10px rgba(0,0,0,.12); transition: .25s; }
        .wl-btn:hover { background: var(--red); color: #fff; }
        .wl-btn.active { background: var(--red); color: #fff; }

        /* Offer section */
        .offer-img { border-radius: 24px; height: 620px; object-fit: cover; }

        /* Newsletter */
        .newsletter-wrap { background: var(--dark); }
        .newsletter-input { border-radius: 50px 0 0 50px; border: none; height: 52px; padding-left: 24px; outline: none; }
        .newsletter-btn { border-radius: 0 50px 50px 0; height: 52px; white-space: nowrap; }

        /* Footer */
        .footer-link { text-decoration: none; color: #666; font-size: 14px; transition: color .2s; }
        .footer-link:hover { color: var(--dark); }
        .social-ico { width: 42px; height: 42px; border-radius: 50%; border: 1px solid #ddd; display: flex; align-items: center; justify-content: center; text-decoration: none; color: var(--dark); transition: .25s; }
        .social-ico:hover { background: var(--dark); color: #fff; border-color: var(--dark); }

        /* Offcanvas */
        .offcanvas { width: 400px !important; }
        .cart-item-img { width: 64px; height: 72px; object-fit: cover; border-radius: 10px; }

        /* Badge */
        .notif-badge { position: absolute; top: -4px; right: -4px; width: 18px; height: 18px; border-radius: 50%; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; }

        @media (max-width: 991px) {
            .hero-img { height: 70vh; }
            .cat-card { height: 340px; }
            .offer-img { height: 420px; }
        }

