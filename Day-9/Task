    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ── State ──────────────────────────────────────────────────────────────
        const cart = [];
        const wishlist = [];

        // ── DOM Refs ───────────────────────────────────────────────────────────
        const cartBadge      = document.getElementById('cartBadge');
        const wlBadge        = document.getElementById('wlBadge');
        const cartCountLabel = document.getElementById('cartCountLabel');
        const wlCountLabel   = document.getElementById('wlCountLabel');
        const cartList       = document.getElementById('cartList');
        const wlList         = document.getElementById('wlList');
        const cartEmpty      = document.getElementById('cartEmpty');
        const wlEmpty        = document.getElementById('wlEmpty');
        const cartFooter     = document.getElementById('cartFooter');
        const cartTotal      = document.getElementById('cartTotal');
        const toastEl        = document.getElementById('toastMsg');
        const toastText      = document.getElementById('toastText');
        const toast          = new bootstrap.Toast(toastEl, { delay: 2200 });

        // ── Helpers ────────────────────────────────────────────────────────────
        function showToast(msg) {
            toastText.textContent = msg;
            toast.show();
        }

        function numericPrice(str) {
            return parseInt(str.replace(/[^\d]/g, ''), 10);
        }

        function updateCartUI() {
            const count = cart.reduce((s, i) => s + i.qty, 0);
            cartBadge.textContent = count;
            cartCountLabel.textContent = count;
            count > 0 ? cartBadge.classList.remove('d-none') : cartBadge.classList.add('d-none');

            if (count === 0) {
                cartList.classList.add('d-none');
                cartFooter.classList.add('d-none');
                cartEmpty.classList.remove('d-none');
            } else {
                cartList.classList.remove('d-none');
                cartFooter.classList.remove('d-none');
                cartEmpty.classList.add('d-none');
            }

            const total = cart.reduce((s, i) => s + numericPrice(i.price) * i.qty, 0);
            cartTotal.textContent = '₹' + total.toLocaleString('en-IN');

            cartList.innerHTML = '';
            cart.forEach((item, idx) => {
                const li = document.createElement('li');
                li.className = 'border-bottom pb-3 mb-3';
                li.innerHTML = `
                    <div class="d-flex gap-3 align-items-start">
                        <img src="${item.img}" class="cart-item-img flex-shrink-0" alt="${item.name}">
                        <div class="flex-grow-1">
                            <div class="fw-semibold">${item.name}</div>
                            <div class="text-muted small mb-2">${item.price}</div>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-circle" style="width:28px;height:28px;padding:0;" onclick="changeQty(${idx},-1)">−</button>
                                <span class="fw-bold">${item.qty}</span>
                                <button class="btn btn-sm btn-dark rounded-circle" style="width:28px;height:28px;padding:0;" onclick="changeQty(${idx},1)">+</button>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger rounded-circle" style="width:32px;height:32px;padding:0;" onclick="removeFromCart(${idx})">
                            <i class="bi bi-trash3" style="font-size:11px;"></i>
                        </button>
                    </div>`;
                cartList.appendChild(li);
            });
        }

        function updateWishlistUI() {
            const count = wishlist.length;
            wlBadge.textContent = count;
            wlCountLabel.textContent = count;
            count > 0 ? wlBadge.classList.remove('d-none') : wlBadge.classList.add('d-none');

            if (count === 0) {
                wlList.classList.add('d-none');
                wlEmpty.classList.remove('d-none');
            } else {
                wlList.classList.remove('d-none');
                wlEmpty.classList.add('d-none');
            }

            wlList.innerHTML = '';
            wishlist.forEach((item, idx) => {
                const li = document.createElement('li');
                li.className = 'border-bottom pb-3 mb-3';
                li.innerHTML = `
                    <div class="d-flex gap-3 align-items-center">
                        <img src="${item.img}" class="cart-item-img flex-shrink-0" alt="${item.name}">
                        <div class="flex-grow-1">
                            <div class="fw-semibold">${item.name}</div>
                            <div class="text-muted small">${item.price}</div>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-sm btn-dark rounded-pill px-2" style="font-size:11px;" onclick="moveToCart(${idx})">Add to Bag</button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-2" style="font-size:11px;" onclick="removeFromWishlist(${idx})">Remove</button>
                        </div>
                    </div>`;
                wlList.appendChild(li);
            });
        }

        // ── Actions ────────────────────────────────────────────────────────────
        function addToCart(name, price, img) {
            const existing = cart.find(i => i.name === name);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ name, price, img, qty: 1 });
            }
            updateCartUI();
            showToast(`"${name}" added to bag!`);
        }

        function changeQty(idx, delta) {
            cart[idx].qty += delta;
            if (cart[idx].qty <= 0) cart.splice(idx, 1);
            updateCartUI();
        }

        function removeFromCart(idx) {
            cart.splice(idx, 1);
            updateCartUI();
        }

        function addToWishlist(btn, name, price, img) {
            const already = wishlist.find(i => i.name === name);
            if (already) {
                showToast(`"${name}" already in wishlist!`);
                return;
            }
            wishlist.push({ name, price, img });
            btn.classList.add('active');
            btn.innerHTML = '<i class="bi bi-heart-fill"></i>';
            updateWishlistUI();
            showToast(`"${name}" saved to wishlist!`);
        }

        function removeFromWishlist(idx) {
            const name = wishlist[idx].name;
            wishlist.splice(idx, 1);
            // Reset the wishlist button on the card
            document.querySelectorAll('.wl-btn').forEach(btn => {
                const card = btn.closest('[data-name]');
                if (card && card.dataset.name === name) {
                    btn.classList.remove('active');
                    btn.innerHTML = '<i class="bi bi-heart"></i>';
                }
            });
            updateWishlistUI();
        }

        function moveToCart(idx) {
            const item = wishlist[idx];
            addToCart(item.name, item.price, item.img);
            removeFromWishlist(idx);
        }

        // ── Event Listeners ────────────────────────────────────────────────────
        document.querySelectorAll('.add-cart-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const card = btn.closest('[data-name]');
                addToCart(card.dataset.name, card.dataset.price, card.dataset.img);
            });
        });

        document.querySelectorAll('.wl-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const card = btn.closest('[data-name]');
                addToWishlist(btn, card.dataset.name, card.dataset.price, card.dataset.img);
            });
        });

        // Initial render
        updateCartUI();
        updateWishlistUI();
    </script>

