          style="height: 95vh;"
          alt="slide">

        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>

        <div class="position-absolute top-50 start-0 translate-middle-y text-white container">

          <div class="col-lg-6">

